{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "choreo-api-schema",
  "title": "Choreo REST and WebSocket API Schema",
  "description": "API payload schemas for the Choreo state server. Domain model references come from document/schema.json.",
  "$defs": {
    "UUID": { "$ref": "schema.json#/$defs/UUID" },
    "ProjectFile": { "$ref": "schema.json#/$defs/ProjectFile" },
    "TrajectoryFile": { "$ref": "schema.json#/$defs/TrajectoryFile" },
    "Waypoint": { "$ref": "schema.json#/$defs/Waypoint" },
    "Constraint": { "$ref": "schema.json#/$defs/Constraint" },
    "EventMarker": { "$ref": "schema.json#/$defs/EventMarker" },
    "OperationId": {
      "type": "integer",
      "minimum": 0
    },

    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },

    "HealthResponse": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "const": "ok" },
        "uptimeMs": { "type": "number", "minimum": 0 },
        "serverVersion": { "type": "string" }
      },
      "required": ["status", "uptimeMs", "serverVersion"],
      "additionalProperties": false
    },

    "ObjectMergePatch": {
      "type": "object",
      "additionalProperties": true
    },

    "PatchRequest": {
      "oneOf": [
        { "$ref": "#/$defs/ObjectMergePatch" },
        { "$ref": "#/$defs/JsonPatchDocument" }
      ]
    },

    "OperationAccepted": {
      "type": "object",
      "properties": {
        "operationId": { "$ref": "#/$defs/OperationId" },
        "state": {
          "type": "string",
          "enum": ["created", "queued", "running", "completed", "failed", "cancelled"]
        }
      },
      "required": ["operationId", "state"],
      "additionalProperties": false
    },

    "OperationTimestamps": {
      "type": "object",
      "properties": {
        "submitted_at": { "type": "string" },
        "started_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "completed_at": { "type": "string" }
      },
      "required": ["submitted_at"],
      "additionalProperties": false
    },

    "OperationRecord": {
      "type": "object",
      "properties": {
        "trajectory_uuid": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": ["created", "queued", "running", "completed", "failed", "cancelled"]
        },
        "timestamps": { "$ref": "#/$defs/OperationTimestamps" },
        "error_message": { "type": "string" },
        "result_revision": { "type": "string" },
        "last_progress_event": { "type": "string" }
      },
      "required": ["trajectory_uuid", "state", "timestamps"],
      "additionalProperties": false
    },

    "CancelAllResponse": {
      "type": "object",
      "properties": {
        "operationId": {
          "oneOf": [
            { "$ref": "#/$defs/OperationId" },
            { "type": "null" }
          ]
        },
        "state": {
          "type": "string",
          "enum": ["completed"]
        },
        "cancelledCount": { "type": "integer", "minimum": 0 }
      },
      "required": ["operationId", "state", "cancelledCount"],
      "additionalProperties": false
    },

    "TrajectoryDeleteResponse": {
      "type": "null"
    },

    "TrajectoryDeletedStateResponse": {
      "type": "object",
      "properties": {
        "uuid": { "$ref": "#/$defs/UUID" },
        "deleted": { "type": "boolean", "const": true }
      },
      "required": ["uuid", "deleted"],
      "additionalProperties": false
    },

    "TrajectoryUndoRedoResponse": {
      "oneOf": [
        { "$ref": "#/$defs/TrajectoryFile" },
        { "$ref": "#/$defs/TrajectoryDeletedStateResponse" }
      ]
    },

    "GenerationStateResponse": {
      "type": "object",
      "properties": {
        "trajectoryUuid": { "$ref": "#/$defs/UUID" },
        "queuePosition": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "latestOperationId": {
          "oneOf": [
            { "$ref": "#/$defs/OperationId" },
            { "type": "null" }
          ]
        },
        "lastCompletionStatus": {
          "oneOf": [
            { "type": "string", "enum": ["success", "failed", "cancelled"] },
            { "type": "null" }
          ]
        }
      },
      "required": ["trajectoryUuid", "queuePosition", "latestOperationId", "lastCompletionStatus"],
      "additionalProperties": false
    },

    "TrajectorySummary": {
      "type": "object",
      "properties": {
        "uuid": { "$ref": "#/$defs/UUID" },
        "name": { "type": "string" },
        "version": { "type": "integer", "minimum": 0 },
        "upToDate": { "type": "boolean" },
        "hasTrajectoryData": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "revision": { "type": "string" }
      },
      "required": ["uuid", "name", "version", "upToDate", "hasTrajectoryData", "updatedAt", "revision"],
      "additionalProperties": false
    },

    "TrajectoryListResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrajectorySummary" }
        },
        "nextCursor": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "totalEstimate": { "type": "integer", "minimum": 0 }
      },
      "required": ["items", "nextCursor", "totalEstimate"],
      "additionalProperties": false
    },

    "TrajectoryListQuery": {
      "type": "object",
      "properties": {
        "q": { "type": "string" },
        "driveType": { "$ref": "schema.json#/$defs/DriveType" },
        "upToDate": { "type": "boolean" },
        "hasTrajectoryData": { "type": "boolean" },
        "sort": {
          "type": "string",
          "enum": ["name", "updatedAt", "version"]
        },
        "order": {
          "type": "string",
          "enum": ["asc", "desc"]
        },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
        "cursor": { "type": "string" },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["uuid", "name", "version", "upToDate", "hasTrajectoryData", "updatedAt", "revision"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },

    "JsonPatchOperation": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": ["add", "remove", "replace", "move", "copy", "test"]
        },
        "path": { "type": "string" },
        "from": { "type": "string" },
        "value": {}
      },
      "required": ["op", "path"],
      "additionalProperties": false
    },

    "JsonPatchDocument": {
      "type": "array",
      "items": { "$ref": "#/$defs/JsonPatchOperation" }
    },

    "ReorderRequest": {
      "type": "object",
      "properties": {
        "order": {
          "type": "array",
          "items": { "$ref": "#/$defs/UUID" },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": ["order"],
      "additionalProperties": false
    },

    "AddWaypointRequest": {
      "type": "object",
      "properties": {
        "waypoint": { "$ref": "#/$defs/Waypoint" },
        "insertIndex": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        }
      },
      "required": ["waypoint"],
      "additionalProperties": false
    },

    "AddConstraintRequest": {
      "type": "object",
      "properties": {
        "constraint": { "$ref": "#/$defs/Constraint" },
        "insertIndex": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        }
      },
      "required": ["constraint"],
      "additionalProperties": false
    },

    "AddMarkerRequest": {
      "type": "object",
      "properties": {
        "marker": { "$ref": "#/$defs/EventMarker" },
        "insertIndex": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        }
      },
      "required": ["marker"],
      "additionalProperties": false
    },

    "RenameTrajectoryRequest": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      },
      "required": ["name"],
      "additionalProperties": false
    },

    "GenerateRequest": {
      "type": "object",
      "additionalProperties": true
    },

    "DiagnosticsResponse": {
      "type": "object",
      "properties": {
        "queueDepth": { "type": "integer", "minimum": 0 },
        "activeOperations": { "type": "integer", "minimum": 0 },
        "avgPersistLatencyMs": { "type": "number", "minimum": 0 },
        "wsClientCount": { "type": "number", "minimum": 0 },
        "lastErrorSummary": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      },
      "required": ["queueDepth", "activeOperations", "avgPersistLatencyMs", "wsClientCount", "lastErrorSummary"],
      "additionalProperties": false
    },

    "ExportBundle": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "exportedAt": { "type": "string" },
        "project": { "$ref": "#/$defs/ProjectFile" },
        "trajectories": {
          "type": "array",
          "items": { "$ref": "#/$defs/TrajectoryFile" }
        }
      },
      "required": ["schemaVersion", "exportedAt", "project", "trajectories"],
      "additionalProperties": false
    },

    "ImportRequest": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["merge", "replace"]
        },
        "bundle": { "$ref": "#/$defs/ExportBundle" },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      },
      "required": ["mode", "bundle"],
      "additionalProperties": false
    },

    "ImportAcceptedResponse": {
      "allOf": [
        { "$ref": "#/$defs/OperationAccepted" },
        {
          "type": "object",
          "properties": {
            "summary": {
              "type": "object",
              "properties": {
                "projectAction": {
                  "type": "string",
                  "enum": ["replace", "merge"]
                },
                "trajectoryCreates": { "type": "integer", "minimum": 0 },
                "trajectoryUpdates": { "type": "integer", "minimum": 0 },
                "trajectoryDeletes": { "type": "integer", "minimum": 0 }
              },
              "required": ["projectAction", "trajectoryCreates", "trajectoryUpdates", "trajectoryDeletes"],
              "additionalProperties": false
            }
          },
          "required": ["summary"],
          "additionalProperties": false
        }
      ]
    },

    "ProgressProducerEvent": {
      "type": "object",
      "description": "Raw JSON progress frame sent by a generator producer over /progress/{operationId}.",
      "properties": {
        "event": { "type": "string" }
      },
      "required": ["event"],
      "additionalProperties": true
    },

    "ProgressSubscriberEvent": {
      "type": "object",
      "description": "Wrapped progress frame rebroadcast to subscribers connected to /progress.",
      "properties": {
        "operationId": { "$ref": "#/$defs/OperationId" },
        "frame": { "$ref": "#/$defs/ProgressProducerEvent" }
      },
      "required": ["operationId", "frame"],
      "additionalProperties": false
    }
  },

  "x-endpoints": {
    "GET /api/v1/health": {
      "response200": { "$ref": "#/$defs/HealthResponse" }
    },
    "GET /api/v1/project": {
      "response200": { "$ref": "#/$defs/ProjectFile" }
    },
    "PUT /api/v1/project": {
      "request": { "$ref": "#/$defs/ProjectFile" },
      "response200": { "$ref": "#/$defs/ProjectFile" }
    },
    "PATCH /api/v1/project": {
      "request": { "$ref": "#/$defs/PatchRequest" },
      "response200": { "$ref": "#/$defs/ProjectFile" }
    },
    "POST /api/v1/project/undo": {
      "response200": { "$ref": "#/$defs/ProjectFile" }
    },
    "POST /api/v1/project/redo": {
      "response200": { "$ref": "#/$defs/ProjectFile" }
    },
    "GET /api/v1/trajectories": {
      "query": { "$ref": "#/$defs/TrajectoryListQuery" },
      "response200": { "$ref": "#/$defs/TrajectoryListResponse" }
    },
    "POST /api/v1/trajectories": {
      "request": { "$ref": "#/$defs/TrajectoryFile" },
      "response201": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "GET /api/v1/trajectories/{uuid}": {
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "POST /api/v1/trajectories/{uuid}/undo": {
      "response200": { "$ref": "#/$defs/TrajectoryUndoRedoResponse" }
    },
    "POST /api/v1/trajectories/{uuid}/redo": {
      "response200": { "$ref": "#/$defs/TrajectoryUndoRedoResponse" }
    },
    "PUT /api/v1/trajectories/{uuid}": {
      "request": { "$ref": "#/$defs/TrajectoryFile" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "PATCH /api/v1/trajectories/{uuid}": {
      "request": { "$ref": "#/$defs/PatchRequest" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "DELETE /api/v1/trajectories/{uuid}": {
      "response204": { "$ref": "#/$defs/TrajectoryDeleteResponse" }
    },
    "POST /api/v1/trajectories/{uuid}/rename": {
      "request": { "$ref": "#/$defs/RenameTrajectoryRequest" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "POST /api/v1/trajectories/{uuid}/waypoints": {
      "request": { "$ref": "#/$defs/AddWaypointRequest" },
      "response201": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "PATCH /api/v1/trajectories/{uuid}/waypoints/{waypointUuid}": {
      "request": { "$ref": "#/$defs/PatchRequest" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "DELETE /api/v1/trajectories/{uuid}/waypoints/{waypointUuid}": {
      "response204": { "$ref": "#/$defs/TrajectoryDeleteResponse" }
    },
    "POST /api/v1/trajectories/{uuid}/waypoints/reorder": {
      "request": { "$ref": "#/$defs/ReorderRequest" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "POST /api/v1/trajectories/{uuid}/constraints": {
      "request": { "$ref": "#/$defs/AddConstraintRequest" },
      "response201": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "PATCH /api/v1/trajectories/{uuid}/constraints/{constraintUuid}": {
      "request": { "$ref": "#/$defs/PatchRequest" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "DELETE /api/v1/trajectories/{uuid}/constraints/{constraintUuid}": {
      "response204": { "$ref": "#/$defs/TrajectoryDeleteResponse" }
    },
    "POST /api/v1/trajectories/{uuid}/constraints/reorder": {
      "request": { "$ref": "#/$defs/ReorderRequest" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "POST /api/v1/trajectories/{uuid}/markers": {
      "request": { "$ref": "#/$defs/AddMarkerRequest" },
      "response201": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "PATCH /api/v1/trajectories/{uuid}/markers/{markerUuid}": {
      "request": { "$ref": "#/$defs/PatchRequest" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "DELETE /api/v1/trajectories/{uuid}/markers/{markerUuid}": {
      "response204": { "$ref": "#/$defs/TrajectoryDeleteResponse" }
    },
    "POST /api/v1/trajectories/{uuid}/markers/reorder": {
      "request": { "$ref": "#/$defs/ReorderRequest" },
      "response200": { "$ref": "#/$defs/TrajectoryFile" }
    },
    "POST /api/v1/trajectories/{uuid}/generate": {
      "request": { "$ref": "#/$defs/GenerateRequest" },
      "response202": { "$ref": "#/$defs/OperationAccepted" }
    },
    "GET /api/v1/trajectories/{uuid}/generation-state": {
      "response200": { "$ref": "#/$defs/GenerationStateResponse" }
    },
    "POST /api/v1/generate/cancel-all": {
      "response202": { "$ref": "#/$defs/CancelAllResponse" }
    },
    "GET /api/v1/diagnostics": {
      "response200": { "$ref": "#/$defs/DiagnosticsResponse" }
    },
    "GET /api/v1/export": {
      "response200": { "$ref": "#/$defs/ExportBundle" }
    },
    "POST /api/v1/import": {
      "request": { "$ref": "#/$defs/ImportRequest" },
      "response202": { "$ref": "#/$defs/ImportAcceptedResponse" }
    },
    "GET /api/v1/operations/{operationId}": {
      "response200": { "$ref": "#/$defs/OperationRecord" }
    },
    "POST /api/v1/operations/{operationId}/cancel": {
      "response202": { "$ref": "#/$defs/OperationAccepted" }
    },
    "WS /progress/{operationId}": {
      "event": { "$ref": "#/$defs/ProgressProducerEvent" }
    },
    "WS /progress": {
      "event": { "$ref": "#/$defs/ProgressSubscriberEvent" }
    }
  }
}
