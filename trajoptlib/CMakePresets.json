{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default build using Ninja generator",
      "binaryDir": "build",
      "generator": "Ninja",
      "cacheVariables": {}
    },
    {
      "name": "with-sccache",
      "displayName": "",
      "description": "Ninja config with sccache",
      "generator": "Ninja",
      "binaryDir": "build",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
      }
    },
    {
      "name": "with-examples",
      "displayName": "Default config to build examples",
      "description": "Default examples build using Ninja generator",
      "binaryDir": "build",
      "generator": "Ninja",
      "cacheVariables": {
        "TRAJOPT_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "with-examples-and-sccache",
      "displayName": "",
      "description": "Ninja config with sccache",
      "generator": "Ninja",
      "binaryDir": "build",
      "inherits": "with-sccache",
      "cacheVariables": {
        "TRAJOPT_BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "with-sccache",
      "configurePreset": "with-sccache"
    },
    {
      "name": "with-examples",
      "configurePreset": "with-examples"
    },
    {
      "name": "with-examples-and-sccache",
      "configurePreset": "with-examples-and-sccache"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "configurePreset": "default"
    },
    {
      "name": "with-sccache",
      "inherits": "base",
      "configurePreset": "with-sccache"
    },
    {
      "name": "with-examples",
      "inherits": "base",
      "configurePreset": "with-examples"
    },
    {
      "name": "with-examples-and-sccache",
      "inherits": "base",
      "configurePreset": "with-examples-and-sccache"
    }
  ]
}
